{
	"name": "backend",
	"version": "0.0.1",
	"description": "Medic Hub",
	"author": "MaridiM",
	"private": true,
	"license": "UNLICENSED",
	"_moduleAliases": {
		"@": "dist",
		"@prisma/__generated__": "prisma/__generated__"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "npm run migrate:run && nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"prisma:format": "npx prisma format",
		"prisma:generate": "npx prisma generate",
		"prisma:reset": "npx prisma migrate reset",
		"prisma:push": "npx prisma db push",
		"prisma:studio": "npx prisma studio",
		"prisma:seed": "ts-node src/core/prisma/prisma.seed.ts",
		"migrate:run": "prisma migrate deploy",
		"migrate:add": "prisma migrate dev --name",
		"test": "jest --config jest.config.mjs",
		"test:watch": "jest --watch  --config jest.config.mjs",
		"test:cov": "jest --coverage  --config jest.config.mjs",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand  --config jest.config.mjs",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"email:dev": "email dev",
		"2fa:generate-key": "ts-node -e \"import { EncryptionUtil } from './src/modules/auth/2fa/utils'; console.log('TWO_FA_ENCRYPTION_KEY=' + EncryptionUtil.generateKey())\"",
		"migrate:2fa": "ts-node prisma/migrations/utils/migrate-to-unified-2fa.ts",
		"verify:2fa": "ts-node prisma/migrations/utils/verify-2fa-migration.ts",
		"rollback:2fa": "ts-node prisma/migrations/utils/rollback-2fa-migration.ts"
	},
	"dependencies": {
		"@apollo/server": "4.12.2",
		"@getbrevo/brevo": "^3.0.1",
		"@godaddy/terminus": "^4.12.1",
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/apollo": "^13.1.0",
		"@nestjs/common": "^11.1.5",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.5",
		"@nestjs/graphql": "^13.1.0",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^11.1.5",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/typeorm": "^11.0.0",
		"@prisma/client": "^6.17.1",
		"@react-email/components": "^0.5.5",
		"@react-email/html": "^0.0.11",
		"@react-email/tailwind": "^1.2.2",
		"@sendgrid/mail": "^8.1.5",
		"argon2": "^0.43.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cloudinary": "^2.7.0",
		"connect-redis": "^9.0.0",
		"cookie-parser": "^1.4.7",
		"cross-env": "^10.0.0",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"device-detector-js": "^3.0.3",
		"dns": "^0.2.2",
		"dotenv": "^17.2.0",
		"dotenv-expand": "^12.0.2",
		"express": "^5.1.0",
		"express-session": "^1.18.2",
		"geoip-lite": "^1.4.10",
		"graphql": "^16.11.0",
		"graphql-subscriptions": "^3.0.0",
		"graphql-upload-minimal": "^1.6.1",
		"i18n-iso-countries": "^7.14.0",
		"i18next": "^25.3.2",
		"i18next-fs-backend": "^2.6.0",
		"i18next-http-middleware": "^3.7.4",
		"module-alias": "^2.2.3",
		"nodemailer": "^7.0.6",
		"otpauth": "^9.4.0",
		"qrcode": "^1.5.4",
		"raw-body": "^3.0.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-email": "^4.2.11",
		"redis": "^5.6.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sharp": "^0.34.3",
		"stripe": "^18.3.0",
		"twilio": "^5.10.2",
		"typeorm": "^0.3.25"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.31.0",
		"@nestjs/cli": "^11.0.7",
		"@nestjs/schematics": "^11.0.5",
		"@nestjs/testing": "^11.1.5",
		"@react-email/preview-server": "4.2.11",
		"@swc/cli": "^0.7.8",
		"@swc/core": "^1.13.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/bun": "^1.2.23",
		"@types/cookie-parser": "^1.4.9",
		"@types/express": "^5.0.3",
		"@types/express-session": "^1.18.2",
		"@types/geoip-lite": "^1.4.4",
		"@types/i18next": "^13.0.0",
		"@types/i18next-fs-backend": "^1.2.0",
		"@types/jest": "^30.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.0.15",
		"@types/nodemailer": "^7.0.1",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19.1.8",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.3",
		"globals": "^16.3.0",
		"jest": "^30.0.5",
		"jest-mock-extended": "^4.0.0",
		"mocha": "^11.7.1",
		"prettier": "^3.6.2",
		"prisma": "^6.17.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.1.3",
		"ts-jest": "^29.4.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.38.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
