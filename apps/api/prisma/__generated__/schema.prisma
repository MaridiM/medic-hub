// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "./__generated__"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id String @id @default(uuid())

  // Profile fields
  fullName  String  @map("full_name")
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  phone     String? @unique
  email     String  @unique

  avatar String?
  bio    String?

  password String

  isEmailVerified Boolean @default(false) @map("is_email_verified")

  // TOTP (Time-based One-Time Password) - Google Authenticator, etc.
  isTotpEnabled Boolean @default(false) @map("is_totp_enabled")
  totpSecret    String? @map("totp_secret") // Encrypted TOTP secret

  // OTP (One-Time Password) - SMS/Email codes
  isOtpEnabled Boolean @default(false) @map("is_otp_enabled")
  otpSecret    String? @map("otp_secret")

  // Relations
  backupCodes BackupCode[]
  auditLogs   AuditLog[]
  tokens      Token[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([isTotpEnabled])
  @@index([isOtpEnabled])
  @@map("users")
}

model Token {
  id String @id @default(uuid())

  token     String     @unique
  type      ETokenType
  expiresIn DateTime   @map("expires_in")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, type]) // один токен каждого типа на пользователя
  @@index([token])
  @@index([expiresIn]) // для очистки истекших токенов
  @@map("tokens")
}

model BackupCode {
  id String @id @default(cuid())

  userId String          @map("user_id")
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   EBackupCodeType @default(TOTP) // TOTP или OTP

  code String // Хешированный backup код (Argon2)

  // Статус использования
  usedAt DateTime? @map("used_at") // null = не использован

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, type])
  @@index([userId, usedAt]) // для быстрого поиска неиспользованных кодов
  @@index([userId, type, usedAt]) // комбинированный индекс
  @@map("backup_codes")
}

model AuditLog {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action String // TOTP_ENABLED, TOTP_DISABLED, TOTP_VERIFIED, etc.

  // Дополнительные данные
  metadata  Json?
  ip        String?
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt]) // для очистки старых логов
  @@map("audit_logs")
}

enum EBackupCodeType {
  TOTP // Time-based OTP backup codes (for Google Authenticator)
  OTP // One-time password backup codes (for SMS/Email)

  @@map("backup_code_types")
}

enum ETokenType {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("token_types")
}
