{
  "name": "medic-hub",
  "version": "0.0.1",
  "description": "Medic Hub",
  "author": "MaridiM",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "backend:dev": "cd backend && bun run start:dev",
    "frontend:dev": "cd frontend && bun run dev",
    "backend:prod": "cd backend && bun run start:prod",
    "frontend:prod": "cd frontend && bun run start:prod",
    "dev": "bun run backend:dev & bun run frontend:dev",
    "prod": "bun run backend:prod & bun run frontend:prod",
    "install": "cd backend && bun install && cd ../frontend && bun install",
    "docker:dev": "docker compose up -d --build",
    "docker:prod": "docker compose -f docker-compose.yml up -d --build",
    "docker:down": "docker compose down -v",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:push": "docker compose push"
  }
}
